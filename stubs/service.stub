<?php

namespace {{ namespace }};

use {{ modelFqcn }};
use {{ repositoryInterfaceFqcn }};
use Illuminate\Database\Eloquent\Collection;

class {{ class }}
{
    public function __construct(
        protected {{ repositoryInterfaceClass }} ${{ entityVariable }}Repository,
    ) {
    }

    /**
     * @return Collection<int, {{ entity }}>
     */
    public function list(): Collection
    {
        return $this->{{ entityVariable }}Repository->all();
    }

    public function find({{ idType }} $id): {{ entity }}
    {
        return $this->{{ entityVariable }}Repository->find($id);
    }

    public function create(array $data): {{ entity }}
    {
        return $this->{{ entityVariable }}Repository->create($data);
    }

    public function update({{ idType }} $id, array $data): {{ entity }}
    {
        return $this->{{ entityVariable }}Repository->update($id, $data);
    }

    public function delete({{ idType }} $id): bool
    {
        return $this->{{ entityVariable }}Repository->delete($id);
    }
}
