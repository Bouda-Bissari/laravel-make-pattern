<?php

namespace {{ namespace }};

use {{ modelFqcn }};
use {{ repositoryInterfaceFqcn }};
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Support\Facades\Log;

class {{ class }} implements {{ repositoryInterfaceClass }}
{
    /**
     * @return Collection<int, {{ entity }}>
     */
    public function all(): Collection
    {
        return {{ entity }}::query()->get();
    }

    public function find({{ idType }} $id): {{ entity }}
    {
        return {{ entity }}::query()->findOrFail($id);
    }

    public function create(array $data): {{ entity }}
    {
        try {
            return {{ entity }}::query()->create($data);
        } catch (\Throwable $e) {
            Log::error('{{ class }}::create failed', [
                'exception' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);

            throw $e;
        }
    }

    public function update({{ idType }} $id, array $data): {{ entity }}
    {
        try {
            ${{ entityVariable }} = $this->find($id);
            ${{ entityVariable }}->update($data);

            return ${{ entityVariable }};
        } catch (\Throwable $e) {
            Log::error('{{ class }}::update failed', [
                'exception' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
                'id' => $id,
            ]);

            throw $e;
        }
    }

    public function delete({{ idType }} $id): bool
    {
        try {
            return (bool) $this->find($id)->delete();
        } catch (\Throwable $e) {
            Log::error('{{ class }}::delete failed', [
                'exception' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
                'id' => $id,
            ]);

            throw $e;
        }
    }
}
